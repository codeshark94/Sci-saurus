+  /** Restore one persisted agent under the configured route and server ownership. */
+  async resume(params: SessionResumeParams): Promise<SessionResumeResult> {
+    const id = params.sessionId
+    if (typeof id !== 'string' || !id.trim()) throw new TypeError('resume requires a nonempty sessionId')
+    if (this.shuttingDown || this.sessions.has(id) || this.sessionCreations.has(id)) {
+      throw new Error(`session is already owned or server is shutting down: ${id}`)
+    }
+    const creation = this.ctx.agents.resume({
+      resumeSessionId: SessionId(id),
+      agentOptions: { provider: this.provider, model: this.model,
+        ...this.maxTokens === undefined ? {} : { maxTokens: this.maxTokens } },
+    }).then(handle => {
+      const rec = { handle }
+      this.sessions.set(id, rec)
+      return rec
+    })
+    this.sessionCreations.set(id, creation)
+    try {
+      await creation
+      return { sessionId: id }
+    } finally {
+      this.sessionCreations.delete(id)
+    }
+  }
+
