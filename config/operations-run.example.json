    "revision": 2,
    "domain": "operational policy configuration",
    "checks": [
      {
        "check_id": "policy-guide-consistency",
        "requirement": "Compare all retry and rate-limit values in the exact JSON candidate and operating guide against the approved supplied values; fail on missing values, mismatches, or additional unsupported behavior. The guide must contain \"at most 3 total attempts per request, including the initial attempt\" so that retries cannot be confused with total attempts."
      },
      {
        "check_id": "execution-evidence-boundary",
        "requirement": "Require the exact staged policy to pass the configured schema checker. Distinguish checker output from deployment, enforcement, stability, or measured service behavior; fail any unsupported claim that the policy has been deployed or tested under load."
