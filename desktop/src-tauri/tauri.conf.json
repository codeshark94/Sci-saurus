{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sci-whale",
  "version": "0.1.0",
  "identifier": "science.sciwhale.desktop",
  "build": {"frontendDist": "../ui", "beforeBuildCommand": "python3 build_backend.py", "beforeDevCommand": "python3 build_backend.py"},
  "app": {"windows": [], "withGlobalTauri": true, "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"}},
  "bundle": {"active": true, "targets": ["app"], "externalBin": ["binaries/sciwhale-backend"], "icon": ["icons/icon.png", "icons/icon.icns"], "macOS": {"minimumSystemVersion": "12.0"}}
}
